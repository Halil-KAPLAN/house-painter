---
import { REGIONS } from '@config/site';
import Icon from '../Icon.astro';

interface Props {
  showHeader?: boolean;
  as?: 'h2' | 'h3';
}

const { showHeader = true, as: Heading = 'h2' }: Props = Astro.props;

const primary = REGIONS.filter((r) => r.tier === 'primary');
const secondary = REGIONS.filter((r) => r.tier === 'secondary');
---

<section class="section bg-sand-100">
  <div class="container-content">
    {showHeader && (
      <div class="max-w-2xl">
        <span class="eyebrow">Nerelere geliyoruz</span>
        <Heading class="section-title">Hizmet Verdiğimiz Bölgeler</Heading>
        <p class="section-lead">
          Merkezimiz Darıca. Gebze ve Çayırova en yoğun çalıştığımız ilçeler; Marmaray
          hattı boyunca Tuzla, Pendik ve Kartal'a da geliyoruz.
        </p>
      </div>
    )}

    {/* Ana bölgeler — daha büyük kartlar */}
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {primary.map((region) => (
        <a href={`/bolgeler/${region.slug}`} class="card card-link group">
          <div class="flex items-start justify-between gap-3">
            <span
              class="flex size-11 items-center justify-center rounded-xl bg-brand-100 text-brand-700"
            >
              <Icon name="map-pin" class="size-6" />
            </span>
            <span class="badge bg-accent-50 text-accent-800 border-accent-100">
              Ana bölge
            </span>
          </div>

          <h3 class="mt-4 text-lg font-bold text-ink-900">{region.name} Boyacı</h3>
          <p class="mt-1 text-sm text-ink-600">{region.city}</p>

          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">
            {region.intro[0]}
          </p>

          <span
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700"
          >
            {region.name} sayfasına git
            <Icon
              name="arrow-right"
              class="size-4 transition-transform group-hover:translate-x-1"
            />
          </span>
        </a>
      ))}
    </div>

    {/* İkincil bölgeler — Marmaray hattı */}
    <div class="mt-8 rounded-card border border-sand-200 bg-white p-6 sm:p-7">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h3 class="text-base font-bold text-ink-900">
            Marmaray hattı boyunca da geliyoruz
          </h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-600">
            Karşıya geçmeden, Anadolu yakasındaki ilçelere ulaşımımız kolay.
          </p>
        </div>

        <ul class="flex flex-wrap gap-2.5">
          {secondary.map((region) => (
            <li>
              <a
                href={`/bolgeler/${region.slug}`}
                class="badge transition-colors hover:border-brand-300 hover:bg-brand-100"
              >
                <Icon name="map-pin" class="size-3.5" />
                {region.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
