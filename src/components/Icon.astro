---
/**
 * Inline SVG ikonlar.
 * Harici ikon kütüphanesi kullanmıyoruz — network isteği sıfır kalsın.
 * Tüm ikonlar 24×24 grid, stroke tabanlı, `currentColor` kullanır.
 */

export type IconName =
  | 'phone'
  | 'whatsapp'
  | 'menu'
  | 'close'
  | 'arrow-right'
  | 'check'
  | 'chevron-down'
  | 'map-pin'
  | 'clock'
  | 'roller'
  | 'shield'
  | 'trowel'
  | 'ceiling'
  | 'palette'
  | 'store'
  | 'building'
  | 'sparkles'
  | 'broom';

interface Props {
  name: IconName;
  class?: string;
  /** Dekoratif ikonlar aria-hidden kalır; anlam taşıyorsa label ver */
  label?: string;
}

const { name, class: className = 'size-6', label } = Astro.props;

const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true', focusable: 'false' } as const);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...a11y}
>
  {name === 'phone' && (
    <path d="M6.6 2.5h-2A2.1 2.1 0 0 0 2.5 4.8c.3 3.9 1.8 7.5 4.3 10.4a20.6 20.6 0 0 0 6 6c2.9 2.5 6.5 4 10.4 4.3h.1a2.1 2.1 0 0 0 2.1-2.1v-2a2.1 2.1 0 0 0-1.8-2.1c-1-.1-2-.4-2.9-.7a2.1 2.1 0 0 0-2.2.5l-.9.9a16.5 16.5 0 0 1-6-6l.9-.9a2.1 2.1 0 0 0 .5-2.2c-.3-.9-.6-1.9-.7-2.9a2.1 2.1 0 0 0-2.1-1.8Z" transform="scale(0.86) translate(1.6 1.2)" />
  )}

  {name === 'whatsapp' && (
    <g stroke="none" fill="currentColor">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.8-.78.97-.15.16-.29.19-.54.06-.25-.12-1.05-.38-1.99-1.23-.74-.65-1.23-1.46-1.38-1.71-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z" />
    </g>
  )}

  {name === 'menu' && (
    <><path d="M3.5 6.5h17" /><path d="M3.5 12h17" /><path d="M3.5 17.5h17" /></>
  )}

  {name === 'close' && (
    <><path d="M5.5 5.5l13 13" /><path d="M18.5 5.5l-13 13" /></>
  )}

  {name === 'arrow-right' && (
    <><path d="M4 12h15" /><path d="M13 6l6 6-6 6" /></>
  )}

  {name === 'check' && <path d="M4.5 12.5l5 5 10-11" />}

  {name === 'chevron-down' && <path d="M6 9.5l6 6 6-6" />}

  {name === 'map-pin' && (
    <><path d="M12 21.5s7.5-6.2 7.5-11.5a7.5 7.5 0 1 0-15 0c0 5.3 7.5 11.5 7.5 11.5Z" /><circle cx="12" cy="10" r="2.75" /></>
  )}

  {name === 'clock' && (
    <><circle cx="12" cy="12" r="9" /><path d="M12 6.75V12l3.5 2" /></>
  )}

  {/* Boya rulosu — iç cephe boyama */}
  {name === 'roller' && (
    <><rect x="3" y="3.5" width="13" height="5.5" rx="1.5" /><path d="M16 6.25h3.25a1.75 1.75 0 0 1 1.75 1.75v2.5a1.75 1.75 0 0 1-1.75 1.75H11.5a1.5 1.5 0 0 0-1.5 1.5v1.75" /><rect x="8.25" y="15.5" width="3.5" height="5.5" rx="1.25" /></>
  )}

  {/* Kalkan — eşya koruma */}
  {name === 'shield' && (
    <><path d="M12 2.75 4.5 5.75v6c0 4.5 3.1 8.2 7.5 9.5 4.4-1.3 7.5-5 7.5-9.5v-6L12 2.75Z" /><path d="M9 12l2.25 2.25L15.25 10" /></>
  )}

  {/* Mala — alçı ve saten */}
  {name === 'trowel' && (
    <><path d="M2.75 8.5 10 3.25l7 5.5-7.25 6.5-7-6.75Z" /><path d="M12.5 14.5l3.25 3.25a1.75 1.75 0 0 0 2.5 0l1.5-1.5" /><path d="M17.75 16.25V21" /></>
  )}

  {/* Tavan / kartonpiyer */}
  {name === 'ceiling' && (
    <><path d="M2.5 5.5h19" /><path d="M2.5 9h19" /><path d="M6.5 9v3" /><path d="M12 9v6" /><path d="M17.5 9v3" /><path d="M4 21h16" /></>
  )}

  {/* Palet — dekoratif boya */}
  {name === 'palette' && (
    <><path d="M12 21.5a9.5 9.5 0 1 1 9.5-9.5c0 2-1.6 2.75-3 2.75h-1.75a2.25 2.25 0 0 0-1.6 3.84 1.75 1.75 0 0 1-1.25 2.9H12Z" /><circle cx="7.75" cy="12" r="1.1" fill="currentColor" stroke="none" /><circle cx="9.75" cy="8" r="1.1" fill="currentColor" stroke="none" /><circle cx="14.25" cy="7.5" r="1.1" fill="currentColor" stroke="none" /></>
  )}

  {/* Dükkân */}
  {name === 'store' && (
    <><path d="M3.5 9.5V20a1 1 0 0 0 1 1h15a1 1 0 0 0 1-1V9.5" /><path d="M2.5 9.5 4.75 3.5h14.5l2.25 6a3 3 0 0 1-5.75 1 3 3 0 0 1-5.5 0 3 3 0 0 1-5.75-1Z" /><path d="M9.5 21v-5.5h5V21" /></>
  )}

  {/* Bina — dış cephe */}
  {name === 'building' && (
    <><path d="M5 21V4.5A1.5 1.5 0 0 1 6.5 3h11A1.5 1.5 0 0 1 19 4.5V21" /><path d="M2.5 21h19" /><path d="M9 7h2" /><path d="M13 7h2" /><path d="M9 11h2" /><path d="M13 11h2" /><path d="M9 15h2" /><path d="M13 15h2" /><path d="M10 21v-2.5h4V21" /></>
  )}

  {name === 'sparkles' && (
    <><path d="M12 3.5 13.6 8.4 18.5 10 13.6 11.6 12 16.5 10.4 11.6 5.5 10 10.4 8.4 12 3.5Z" /><path d="M18.5 16.5 19.2 18.3 21 19l-1.8.7-.7 1.8-.7-1.8L16 19l1.8-.7.7-1.8Z" /></>
  )}

  {/* Süpürge — tertemiz teslim */}
  {name === 'broom' && (
    <><path d="M14 3.5 20.5 10" /><path d="M15.75 8.25 8.5 15.5" /><path d="M11.5 11.25 4.5 18.25a2.5 2.5 0 0 0 0 3.5h9l4.5-4.5-6.5-6Z" /><path d="M8 18.5h5" /></>
  )}
</svg>
