---
/**
 * Alt sayfaların ortak başlık bloğu: breadcrumb + h1 + açıklama.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  crumbs: Crumb[];
}

const { eyebrow, heading, lead, crumbs } = Astro.props;
---

<section class="border-b border-sand-200 bg-sand-100">
  <div class="container-content py-10 sm:py-14">
    <Breadcrumbs {crumbs} />

    <div class="mt-6 max-w-3xl">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1
        class="mt-2 font-bold text-ink-900"
        style="font-size: var(--text-section); line-height: var(--text-section--line-height); letter-spacing: var(--text-section--letter-spacing);"
      >
        {heading}
      </h1>
      {lead && <p class="section-lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
