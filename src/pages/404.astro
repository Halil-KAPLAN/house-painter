---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import { SERVICES, REGIONS, phoneHref, CONTACT } from '@config/site';
---

<BaseLayout
  title="Sayfa Bulunamadı | Bülent Usta"
  description="Aradığınız sayfa bulunamadı. Ana sayfaya dönebilir, hizmetlerimize ve hizmet bölgelerimize göz atabilir ya da doğrudan arayıp işinizi anlatabilirsiniz."
  noindex
>
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="badge">404</span>
        <h1 class="section-title mt-4">Aradığınız Sayfa Bulunamadı</h1>
        <p class="section-lead mx-auto">
          Bağlantı eski olabilir ya da adres yanlış yazılmış olabilir. Aşağıdan devam
          edebilir veya doğrudan arayabilirsiniz.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/" class="btn btn-primary">Ana sayfaya dön</a>
          <a href={phoneHref} class="btn btn-outline">
            <Icon name="phone" class="size-4.5" />
            {CONTACT.phoneDisplay}
          </a>
        </div>
      </div>

      <div class="mx-auto mt-14 grid max-w-4xl gap-8 sm:grid-cols-2">
        <div class="card">
          <h2 class="text-base font-bold text-ink-900">Hizmetlerimiz</h2>
          <ul class="mt-3.5 space-y-1">
            {SERVICES.map((s) => (
              <li>
                <a
                  href={`/hizmetler/${s.slug}`}
                  class="flex items-center justify-between gap-3 rounded-lg px-3 py-3 text-sm font-semibold text-ink-600 transition-colors hover:bg-ink-50 hover:text-brand-700"
                >
                  {s.title}
                  <Icon name="arrow-right" class="size-4 shrink-0 text-ink-300" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="card">
          <h2 class="text-base font-bold text-ink-900">Hizmet bölgelerimiz</h2>
          <ul class="mt-3.5 space-y-1">
            {REGIONS.map((r) => (
              <li>
                <a
                  href={`/bolgeler/${r.slug}`}
                  class="flex items-center justify-between gap-3 rounded-lg px-3 py-3 text-sm font-semibold text-ink-600 transition-colors hover:bg-ink-50 hover:text-brand-700"
                >
                  {r.name} Boyacı
                  <Icon name="arrow-right" class="size-4 shrink-0 text-ink-300" />
                </a>
              </li>
            ))}
          </ul>
          <a
            href="/yaptigimiz-isler"
            class="mt-1 inline-flex min-h-11 items-center gap-1.5 px-3 text-sm font-semibold text-brand-700"
          >
            Yaptığımız işlere bak
            <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
