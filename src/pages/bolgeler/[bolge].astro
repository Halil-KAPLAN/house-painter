---
/**
 * Bölge (ilçe) detay sayfası — tek şablon, 6 sayfa üretir.
 *
 * ⚠️ ŞABLON paylaşılır, METİN paylaşılmaz.
 * Her ilçenin giriş paragrafları, bina stoğuna özgü teknik anlatımı, mahalle listesi
 * ve öne çıkan hizmetleri site.ts içinde AYRI AYRI yazılmıştır.
 * Aynı metnin ilçe adı değiştirilmiş hâli Google'ın "doorway page" tanımına girer
 * ve manuel işlem (ceza) sebebidir. Yeni bölge eklerken metni de özgün yazın.
 * Detay: docs/03-SEO.md
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import RelatedWorks from '@components/RelatedWorks.astro';
import ContactCta from '@components/sections/ContactCta.astro';
import Icon from '@components/Icon.astro';
import type { IconName } from '@components/Icon.astro';
import { REGIONS, SERVICES, SITE, phoneHref, whatsappHref, CONTACT } from '@config/site';

export const getStaticPaths = (() =>
  REGIONS.map((region) => ({
    params: { bolge: region.slug },
    props: { region },
  }))) satisfies GetStaticPaths;

const { region } = Astro.props;

const crumbs = [
  { label: 'Bölgeler', href: '/bolgeler' },
  { label: `${region.name} Boyacı`, href: `/bolgeler/${region.slug}` },
];

const highlighted = region.highlightServices
  .map((slug) => SERVICES.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => s !== undefined);

const otherRegions = REGIONS.filter((r) => r.slug !== region.slug);

const areaSchema = {
  '@type': 'Service',
  name: `${region.name} Boyacı — Boya, Alçı ve Saten Hizmeti`,
  description: region.metaDescription,
  url: `${SITE.url}/bolgeler/${region.slug}`,
  provider: { '@id': `${SITE.url}/#boyaci` },
  areaServed: {
    '@type': 'City',
    name: region.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: region.city },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${region.name} boya hizmetleri`,
    itemListElement: highlighted.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        url: `${SITE.url}/hizmetler/${s.slug}`,
      },
    })),
  },
};
---

<BaseLayout
  title={region.metaTitle}
  description={region.metaDescription}
  {crumbs}
  schemas={[areaSchema]}
  whatsappContext={`${region.name}'daki boya işim`}
>
  <PageHeader
    eyebrow={`${region.city} · Hizmet bölgesi`}
    heading={`${region.name} Boyacı — İç Cephe Boyama, Alçı ve Saten`}
    {crumbs}
  >
    <div class="prose-body mt-5">
      {region.intro.map((p) => <p>{p}</p>)}
    </div>

    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href={phoneHref} class="btn btn-primary">
        <Icon name="phone" class="size-4.5" />
        {region.name} için ara — {CONTACT.phoneDisplay}
      </a>
      <a href={whatsappHref} target="_blank" rel="noopener" class="btn btn-whatsapp">
        <Icon name="whatsapp" class="size-4.5" />
        WhatsApp
      </a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="container-content">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
        <div>
          {/* İlçeye özgü teknik anlatım — her sayfada FARKLI içerik */}
          <div class="prose-body">
            <h2 class="!mt-0">{region.localAngle.heading}</h2>
            {region.localAngle.body.map((p) => <p>{p}</p>)}
          </div>

          {/* Bu bölgede öne çıkan hizmetler */}
          <h2 class="section-title mt-14 !text-2xl">
            {region.name}'da en çok istenen işler
          </h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            {highlighted.map((service) => (
              <a href={`/hizmetler/${service.slug}`} class="card card-link group">
                <span
                  class="flex size-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700"
                >
                  <Icon name={service.icon as IconName} class="size-6" />
                </span>
                <h3 class="mt-3.5 text-base font-bold text-ink-900">{service.title}</h3>
                <p class="mt-1.5 flex-1 text-sm leading-relaxed text-ink-500">
                  {service.summary}
                </p>
                <span
                  class="mt-3.5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700"
                >
                  Detaylı bilgi
                  <Icon
                    name="arrow-right"
                    class="size-4 transition-transform group-hover:translate-x-1"
                  />
                </span>
              </a>
            ))}
          </div>

          {/* Mahalleler — gerçek liste, her ilçede farklı */}
          <h2 class="section-title mt-14 !text-2xl">
            {region.name}'ın hangi mahallelerine geliyoruz?
          </h2>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-600">
            {region.name} genelinde çalışıyoruz. Aşağıda mahalleniz yoksa da arayın —
            büyük ihtimalle geliyoruzdur.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {region.neighbourhoods.map((n) => (
              <li class="badge border-ink-200 bg-ink-50 text-ink-600">
                <Icon name="map-pin" class="size-3.5 text-brand-500" />
                {n}
              </li>
            ))}
          </ul>
        </div>

        {/* Yan sütun */}
        <aside class="flex flex-col gap-6 lg:sticky lg:top-24 lg:self-start">
          <div class="card border-brand-200 bg-brand-50">
            <span
              class="flex size-11 items-center justify-center rounded-xl bg-brand-700 text-white"
            >
              <Icon name="map-pin" class="size-6" />
            </span>
            <h2 class="mt-4 text-base font-bold text-ink-900">
              {region.name}'da keşif ücretsiz
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">
              Arayın, gelip yerinde bakalım. Ne yapılması gerektiğini anlatır, net fiyat
              veririz.
            </p>
            <a href={phoneHref} class="btn btn-primary mt-5 w-full">
              <Icon name="phone" class="size-4.5" />
              {CONTACT.phoneDisplay}
            </a>
            {/* brand-50 zemin üzerinde ink-500 4.37:1 kalıyor → ink-600 */}
            <p class="mt-3.5 flex items-center gap-2 text-xs text-ink-600">
              <Icon name="clock" class="size-4 shrink-0 text-brand-600" />
              {CONTACT.openingHoursDisplay}
            </p>
          </div>

          <div class="card">
            <h2 class="text-base font-bold text-ink-900">Tüm hizmetler</h2>
            <ul class="mt-3.5 space-y-1">
              {SERVICES.map((s) => (
                <li>
                  <a
                    href={`/hizmetler/${s.slug}`}
                    class="flex items-center justify-between gap-3 rounded-lg px-3 py-3 text-sm font-semibold text-ink-600 transition-colors hover:bg-ink-50 hover:text-brand-700"
                  >
                    {s.title}
                    <Icon name="arrow-right" class="size-4 shrink-0 text-ink-300" />
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="card">
            <h2 class="text-base font-bold text-ink-900">Diğer bölgeler</h2>
            <ul class="mt-3.5 flex flex-wrap gap-2">
              {otherRegions.map((r) => (
                <li>
                  <a
                    href={`/bolgeler/${r.slug}`}
                    class="badge transition-colors hover:border-brand-300 hover:bg-brand-100"
                  >
                    {r.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <RelatedWorks
    ids={region.workIds}
    heading={`${region.name} ve Çevresinde Yaptığımız İşler`}
    lead="Bu bölgede ve yakın çevresinde tamamladığımız işlerden örnekler."
  />

  <ContactCta
    heading={`${region.name}'da Boya İşiniz mi Var?`}
    body="Arayın, gelip yerinde bakalım. Keşif ücretsiz — ne yapılması gerektiğini anlatır, net fiyat veririz."
  />
</BaseLayout>
